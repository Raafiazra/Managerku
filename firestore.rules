rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/{collectionName}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collectionName in [
          'categories',
          'properties',
          'units',
          'tenants',
          'expenses',
          'payments',
          'invoices',
          'archives',
          'settings'
        ];
    }
  }
}
